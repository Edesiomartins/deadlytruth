# ============================================
# Deadly Truth - Configuração de Ambiente
# ============================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp env.example .env
# 2. Preencha os valores abaixo com suas chaves de API
# 3. NUNCA commite o arquivo .env (já está no .gitignore)
#
# ============================================

# ============================================
# PROVEDOR DE IA
# ============================================
# Escolha qual provedor de IA usar:
# - "groq" (padrão) - Rápido e grátis (com limite)
# - "deepseek" - Muito inteligente e barato
# - "openrouter" - Acesso a 100+ modelos (GPT-4, Claude, etc)
AI_PROVIDER=groq

# ============================================
# GROQ API (Llama 3.3 70B)
# ============================================
# Obtenha sua chave em: https://console.groq.com/
GROQ_API_KEY=gsk_sua_chave_groq_aqui

# ============================================
# DEEPSEEK API
# ============================================
# Obtenha sua chave em: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk_sua_chave_deepseek_aqui

# ============================================
# OPENROUTER API
# ============================================
# Obtenha sua chave em: https://openrouter.ai/
# A chave começa com: sk-or-v1-
OPENROUTER_API_KEY=sk-or-v1-sua_chave_openrouter_aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Deadly Truth
OPENROUTER_PRIMARY_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_FALLBACK_MODEL=z-ai/glm-4.5-air:free
AI_TIMEOUT_SECONDS=10

# ============================================
# BANCO DE DADOS
# ============================================
# Para desenvolvimento local (SQLite):
# DATABASE_URL=sqlite:///./deadly_truth.db

# Para produção (PostgreSQL - Railway):
# DATABASE_URL será configurado automaticamente pelo Railway
# DATABASE_URL=postgresql://user:password@host:port/dbname

# ============================================
# AUTENTICAÇÃO JWT
# ============================================
# Chave secreta para assinar tokens JWT
# GERE UMA CHAVE SEGURA (não use esta em produção!)
# Exemplo: openssl rand -hex 32
SECRET_KEY=sua_chave_secreta_super_segura_aqui_altere_em_producao

# Tempo de expiração do token (em minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# WEBSOCKET
# ============================================
# Requer autenticação para WebSocket? (true/false)
# Se false, permite conexões anônimas
REQUIRE_AUTH_WS=false

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
# URLs permitidas para requisições CORS
# Separe múltiplas URLs por vírgula
# No Railway, isso será configurado automaticamente
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# AMBIENTE
# ============================================
# Ambiente de execução: development, production
ENVIRONMENT=development

# ============================================
# LOGGING
# ============================================
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
